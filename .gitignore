```gitignore
# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/


# =========================
# Django
# =========================

# Local database
db.sqlite3
db.sqlite3-journal

# Django static/media files
staticfiles/
media/

# Environment variables
.env
.env.*
!.env.example


# =========================
# Node.js / npm
# =========================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional package manager files
.npm/


# =========================
# Tailwind / PostCSS
# =========================

# Generated CSS
# Keep source CSS, ignore generated output
core/static/css/output.css


# =========================
# IDE / Editors
# =========================

.vscode/
.idea/

# VS Code local history
.history/

# Editor temporary files
*.swp
*.swo
*~


# =========================
# OS
# =========================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
.directory


# =========================
# Logs
# =========================

*.log
logs/


# =========================
# Environment / Secrets
# =========================

*.pem
*.key
*.crt

# Local configuration
local_settings.py


# =========================
# Build / Cache
# =========================

.cache/
.parcel-cache/
.tmp/
temp/
tmp/


# =========================
# Coverage / Reports
# =========================

coverage/
.pyre/
.pytype/


# =========================
# Backup files
# =========================

*.bak
*.tmp
*.orig
*.rej
```
